# =============================================
# Gospel of Truth Mission - Environment Config
# =============================================

# Server
PORT=5000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/gotm_church_db

# JWT Secrets (change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_EXPIRES_IN=7d

# Head Admin (auto-created on first run)
HEAD_ADMIN_EMAIL=headadmin@yourdomain.com
HEAD_ADMIN_PASSWORD=ChangeThis@2024!
HEAD_ADMIN_FULLNAME=Head Administrator

# Email (SMTP - use Gmail App Password or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@gospeloftruth.org

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://your-frontend-url.com

# Optional: Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
